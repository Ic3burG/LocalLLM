#!/usr/bin/env bash
# Pre-commit hook — auto-formats and re-stages so commits never fail CI for
# formatting reasons. If anything cannot be auto-fixed, exits non-zero so the
# commit is blocked until a human resolves it.
set -e

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

# Only act on files that are staged for this commit.
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "▶ pre-commit: prettier --write on staged files..."
# Run prettier on every staged file it knows how to format. --ignore-unknown
# silently skips file types prettier doesn't handle (Python, binaries, etc.).
echo "$STAGED_FILES" | xargs npx prettier --write --ignore-unknown

echo "▶ pre-commit: ruff format on staged Python files..."
PY_FILES="$(echo "$STAGED_FILES" | grep -E '\.py$' || true)"
if [ -n "$PY_FILES" ]; then
  echo "$PY_FILES" | xargs ruff format
  echo "$PY_FILES" | xargs ruff check --fix --exit-zero
fi

# Re-stage anything the formatters changed.
echo "$STAGED_FILES" | xargs git add

# Final verification — these MUST pass or the commit is blocked.
echo "▶ pre-commit: prettier --check (verification)..."
npx prettier --check .

echo "▶ pre-commit: ruff check (verification)..."
ruff check .

echo "▶ pre-commit: ruff format --check (verification)..."
ruff format --check .

echo "✅ pre-commit: all checks passed."
